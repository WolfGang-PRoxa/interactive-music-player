# Discord Bot Token — https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Secret OAuth2 de l'application — même page, onglet « OAuth2 ».
#
# C'est lui qui permet de se connecter au tableau de bord avec son compte
# Discord. Le premier compte à s'y connecter en présentant le jeton d'accès
# devient le propriétaire de l'installation, et le partage du contrôle avec
# d'autres auditeurs n'a de sens qu'à partir de là.
#
# Laissé vide, la connexion Discord est impossible : le tableau de bord le dit
# et retombe sur le seul jeton d'accès, comme dans les versions antérieures.
# Personne ne se retrouve enfermé dehors, mais personne n'est identifié non plus.
DISCORD_CLIENT_SECRET=

# --- Partage du tableau de bord ---
#
# Par défaut, rien à renseigner ici : la fenêtre « Joindre depuis l'extérieur »
# du tableau de bord télécharge cloudflared et ouvre un tunnel Cloudflare, sans
# compte. Son adresse (https://….trycloudflare.com) change à chaque lancement,
# et la connexion Discord passe par un relais de retour fixe. Déclarez UNE FOIS
# dans le portail développeur (onglet OAuth2 → Redirects) l'adresse du relais :
#
#     https://imp-auth.romainpiau.dev/discord/callback
#
# (la fenêtre de partage la copie pour vous, et le journal la rappelle au
# démarrage).

# Adresse FIXE par laquelle les invités atteignent ce tableau de bord, sans barre
# oblique finale : un domaine derrière un tunnel nommé, une IP de réseau local.
# Laissez vide pour le partage rapide.
#
# Renseignée, elle remplace le relais : déclarez alors dans le portail
#
#     <PUBLIC_URL>/auth/discord/callback
#
# Exemple pour un réseau local : PUBLIC_URL=http://192.168.1.20:3000
# donne à déclarer   http://192.168.1.20:3000/auth/discord/callback
PUBLIC_URL=

# Jeton d'un tunnel nommé, pour une adresse fixe sur votre propre domaine.
# Créez le tunnel dans le tableau de bord Cloudflare (Zero Trust → Networks →
# Tunnels), donnez-lui un nom d'hôte qui mène à http://localhost:3000, puis
# collez ici le jeton et mettez ce nom d'hôte dans PUBLIC_URL. Laissez vide pour
# le partage rapide. Ce jeton permet de faire tourner le tunnel n'importe où :
# gardez-le pour vous.
CLOUDFLARE_TUNNEL_TOKEN=

# Relais de retour OAuth employé quand PUBLIC_URL est vide. Laissez vide pour le
# relais par défaut ; « off » pour s'en passer (la connexion Discord ne marche
# alors que depuis cette machine).
OAUTH_RELAY_URL=

# --- Tableau de bord web ---
# Port d'écoute (défaut : 3000)
PORT=3000

# Interface d'écoute. 127.0.0.1 = accessible uniquement depuis cette machine.
# Mettre 0.0.0.0 pour y accéder depuis le réseau local (téléphone, autre PC).
HOST=127.0.0.1

# Ouverture automatique du tableau de bord au demarrage (defaut : true).
# false est utile lorsque le bot tourne sur une machine pilotee a distance :
# ce tableau de bord jouerait la musique en double.
AUTO_OPEN_DASHBOARD=true

# Jeton d'accès au dashboard. Laisser vide : il est généré au premier démarrage
# et enregistré dans data/dashboard-token (également affiché dans la console).
DASHBOARD_TOKEN=

# Dossiers de musique locaux autorisés au streaming, en plus de data/uploads et
# data/cache. Séparateur ';' ou ','. Tout fichier hors de ces racines est refusé.
# Exemple : MEDIA_ROOTS=D:\Musique;E:\Films
MEDIA_ROOTS=

# Taille maximale d'un fichier uploadé, en Mo (défaut : 1024)
MAX_UPLOAD_MB=1024

# Plafond du cache de préchargement dans data/cache, en Mo (défaut : 2048)
MAX_CACHE_MB=2048

# Nombre de journaux conservés dans data/logs (un par démarrage, défaut : 20)
LOG_RETENTION=20

# Verbosité : debug | info | warn | error (défaut : debug)
LOG_LEVEL=debug

# Spotify API — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Deezer — Cookie ARL (optionnel)
DEEZER_ARL=

# Qobuz (optionnel)
QOBUZ_EMAIL=
QOBUZ_PASSWORD=
